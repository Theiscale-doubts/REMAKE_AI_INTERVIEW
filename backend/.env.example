# ── Required ─────────────────────────────────────────────────────────────
# Groq powers transcription (Whisper), the interview turns and the final
# evaluation. This key alone is a complete, working configuration.
GROQ_API_KEY=your_groq_api_key

# Password for the /admin console. Also switches ON the invite-code gate:
# with neither this nor INVITE_CODES set, /api/start is open to anyone.
ADMIN_PASSWORD=your_chosen_password

# ── Optional ─────────────────────────────────────────────────────────────
# A second LLM provider. When set it is used as a fallback (or first, per
# LLM_PROVIDER_ORDER). Leave empty to run Groq-only — the service starts fine
# without it.
OPENAI_API_KEY=

# Google Sheets service-account JSON, on one line. This is the DURABLE record
# of every interview: on a host with an ephemeral filesystem (Render free tier)
# the local JSON stores are wiped on each deploy and cold start, and this is
# the only copy that survives. Strongly recommended in production.
google_credentials_json={"type":"service_account","project_id":"your_project_id"}

# Always-valid invite codes, comma-separated. Unlike codes minted in the admin
# console, these live in the environment and survive restarts.
INVITE_CODES=

# Browser origins allowed to call this API, comma-separated. Set this to your
# frontend's real origin in production (e.g. https://yourdomain.com).
# Unset or "*" allows any origin.
ALLOWED_ORIGINS=*

# ── Tunables ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Provider preference, first to last. "groq,openai" leads with Groq.
LLM_PROVIDER_ORDER=openai,groq
OPENAI_MODEL=gpt-4o-mini
# Groq model id. Groq retires model names periodically; override here rather
# than editing code if that happens.
GROQ_MODEL=openai/gpt-oss-120b
WHISPER_MODEL=whisper-large-v3-turbo
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1

# Memory bounds. Lower these if the instance is memory-constrained.
SESSION_TTL_SECONDS=21600
MAX_TRACKED_SESSIONS=500
MAX_STORED_SESSIONS=400

# Abuse protection.
GLOBAL_RATE_LIMIT=240
MAX_BODY_BYTES=12582912

# Directory for the JSON stores. Point at a mounted disk to make them durable.
# DATA_DIR=/var/data
